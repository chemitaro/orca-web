package spec

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "画面（web/）の表示と配置と、広い画面の始めの選び方だけを変える。サーバーと Orca への操作を足さない。PR を戻せば元に戻る"
}

purpose: "指揮の画面の標準を、Orca のエージェントのダッシュボードと同じく、対応が必要・作業中・完了の3列にする。会話を選んだときは今の2ペイン（左に一覧、右に会話）にし、閉じれば3列に戻る。狭い画面では今のとおり、選ぶと会話が画面いっぱいになる。"

background: """
	利用者の依頼（2026-11-26、会話）：Orca のエージェントのダッシュボードは、対応が必要・作業中・完了の3つの列でエージェントを管理している。指揮の画面でも、特定のチャットを開いていないときは、画面を3列にして、対応が必要・作業中・完了を縦に並べてほしい。以前の完了・眠っている・不明・結べない仕事は、完了の列の下の方に、基本は閉じたアコーディオンとして置き、押せば開く。3列を標準の画面にし、特定のチャットを開くと今の縦1列（一覧）と会話の画面、チャットを閉じれば3列に戻る。スマホなど幅の狭いものは、チャットが画面全体になる。
	今の画面（iss-00077・iss-00102・iss-00104）：幅 900px 以上は、左に一覧 320px と右に会話の2ペインで、最初の読みで対応が必要の先頭を自動で選ぶ（`initialSelection` の autoPick）。「← 一覧」は 900px 以上では隠している。段は7つ（needs_action・working・done_recent と、畳む done_older・sleeping・unknown・unlinked）。
	"""

includes: ["3列の配置（列の組み立て、描き方、CSS）", "広い画面で自動で頂点を選ばない", "広い画面でも会話を閉じる（3列に戻る）操作"]
excludes: ["サーバー（`src/`）と /api/apexes の文書", "段の分け方（どの頂点がどの段か）", "幅 900px 未満の配置"]

requirements: {
	"R-01": {
		title: "選んでいないときは3列"
		text:  "幅 900px 以上で頂点を選んでいないとき、右のペインを出さず、画面の幅いっぱいに3つの列を並べる：対応が必要の列（段 needs_action）、作業中の列（段 working）、完了の列（段 done_recent と、その下に畳んだ段 done_older・sleeping・unknown・unlinked をこの順に）。畳んだ段は今のとおり details で、基本は閉じ、押せば開く（描き直しでも開いたまま）。ページは縦に巻かず、列はそれぞれの中で縦に巻く。行の中身・選ぶボタン・Orca で開く・新しいタブで開くは今のまま。"
		acceptance: ["900px 以上・選んでいないとき、一覧が3列の grid で、右のペインが出ない", "完了の列の中で、完了の段の後に畳んだ4つの段が閉じた details で並ぶ", "各列が overflow-y auto"]
	}
	"R-02": {
		title: "選ぶと2ペイン、閉じると3列"
		text:  "行を押して頂点を選ぶと、今の2ペイン（左に一覧 320px を1列で、右に会話）にする。一覧の1列の中の段の並びは今と同じ（3つの列を縦に重ねる）。右のペインの見出しの「← 一覧」は 900px 以上でも出し、押すと選びを外して3列に戻る（?apex= を外す）。"
		acceptance: ["900px 以上で「← 一覧」が隠されない", "選んだときの一覧は1列で、段の並びが今と同じ"]
	}
	"R-03": {
		title: "広い画面でも自動で選ばない"
		text:  "最初の読みで頂点を自動で選ばない（3列が標準）。?apex= があればその頂点を選ぶ（今のとおり）。"
		acceptance: ["?apex= のない最初の読みの後、選びが null のまま"]
	}
	"R-04": {
		title: "狭い画面は今のまま"
		text:  "幅 900px 未満では、選んでいなければ今の1列の一覧（段は今と同じ順）、選べば会話が画面全体（iss-00104）。"
		acceptance: ["900px 未満の既存の規則と試験がそのまま通る"]
	}
}

constraints: ["AGENTS.md：DOM は textContent だけ。iframe の src を書き換えず作り直す", "実行時の依存を足さない"]
decisions: [
	"選んでいないときの標準を3列にし、以前の完了・眠っている・不明・結べない仕事は完了の列の下に閉じたアコーディオンで置く。選ぶと縦1列と会話、閉じれば3列。狭い画面は会話が全体（利用者、2026-11-26、会話）",
	"3列を標準にするため、広い画面の自動の選びをやめる（タスク担当、2026-11-26）",
	"コーディングは Opus 5.5 で行う（利用者、2026-11-26、会話）",
]
