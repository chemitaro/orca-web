package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。
// 文章の項目には Markdown を書いてよい。型にない項目は、必要に応じて足してよい。

// 型の版。消さない。
schema: "specdock/v1"

// 保証レベル（light、standard、strict、critical）と、その理由。
// 失敗したときの影響と回復の難しさで選ぶ（工数や作業の難しさでは選ばない）。
// 具体化や作業の途中で、上げても下げてもよい。正本はここだけで、ほかの場所に写さない。
assurance: {
	level:  "standard"
	reason: "既存の承認の答えの経路（iss-00050・iss-00054、どちらも standard。票、指紋、二度と送らない記録、常に許可の確かめの段）を、新しい画面から同じ枠でメンバーに開いて使うだけで、送信の門・記録は変えない。誤ると違うメンバーの画面を開くが、答えは既存のカードで人が押し、戻すのは PR を戻すか sendEnabled を偽にする。2026-11-25 にタスク担当が strict から下げた（前例に合わせる）"
}

purpose: "指揮の画面で頂点を選ぶと、会話の上に、その頂点のチームで人の手が要るもの（メンバーの許可待ち・入力待ち、メンバーの質問 ask・判断 gate）のカードが出る。メンバーの許可待ちには、同じ枠でそのメンバーの画面を開いて既存のカードで答えられる。質問・判断は、頂点の入力欄に決めた型の下書きを入れ、人が頂点に送る。"

background: """
	Epic epic-00075 の切り分け（R-09）。利用者の判断（2026-11-25）：メンバーの許可待ちは基本は統括がさばくが、さばかれず止まることもあるので、例外として表示し答えられる。人が介入するのは基本は頂点。
	答える経路は既存のもの（`/embed/agent` の質問・承認のカード、`/api/answer/*`・`/api/approval/*`、送信の門・票・指紋・二度と送らない記録）だけを使い、新しい送る経路を足さない。メンバーの ask・gate の本文は orca-web が拾っていない（AGENTS.md の read-mail.ts）ので、下書きは決めた型の文と識別子だけにする。
	Opus 5.5 のレビュアーの提案（2026-11-25）：メンバーに答えるときは同じ枠の iframe を作り直し `/embed/agent?id=<メンバー>&compose=off`、下書きは postMessage（同じオリジン・親から・送らない・送信中は受けない・書きかけを上書きしない）。
	"""

includes: [
	"対応のカードの欄（右のペインの会話の上）",
	"`/embed/agent` の `compose=off`（送る欄を出さない。質問・承認のカードはそのまま）",
	"メンバーの画面への切り替えと「頂点に戻る」",
	"`/embed/agent` が親からの下書きを受ける口（postMessage）",
]
excludes: [
	"新しい送る経路、gate・ask へ orca-web から直接答えること",
	"メンバーの入力欄（メンバーへ自由な文を送ること）",
	"送信の門・票・記録の変更",
]

requirements: {
	"R-01": {
		title: "頂点のチームの対応をカードで出す"
		text: """
			カードの種類（その頂点の文書の理由と束から）：
			- メンバーの許可待ち・入力待ち（理由 member_blocked・member_waiting のメンバーごと）：「〈メンバーの題名〉が許可待ち／入力待ち」と［見て答える］。
			- メンバーの質問・判断（束の Dispatch の attention input・approval ごと）：「〈task の題名〉の質問（ask）／判断（gate）」と［頂点に伝える］。
			- 頂点自身の許可待ち・入力待ち（apex_blocked・apex_waiting）：「会話のカードで答えてください」だけ（答える操作は会話の中の既存のカードにある）。
			カードは決めた順（頂点、メンバーの許可待ち、質問・判断）で、なければ欄を出さない。
			"""
		acceptance: [
			"メンバーが許可待ちの頂点を選ぶと、そのメンバーのカードが出る",
			"対応のない頂点ではカードの欄がない",
		]
	}
	"R-02": {
		title: "メンバーの許可待ちに、同じ枠でそのメンバーの画面を開いて答える"
		text:  "［見て答える］を押すと、右のペインの iframe を作り直して `/embed/agent?id=<メンバー>&compose=off` を開き、見出しに「メンバー〈題名〉（答えるだけ）［頂点に戻る］」の帯を出す。`compose=off` の `/embed/agent` は送る欄を出さず、質問・承認のカードと会話はそのまま出す（答えは既存の経路）。［頂点に戻る］で頂点の枠に作り直す。切り替えの前の確かめ（iss-00077 の data-unsettled）は同じく効く。"
		acceptance: [
			"［見て答える］で、枠がそのメンバーの `/embed/agent?id=…&compose=off` になり、送る欄がない",
			"`compose=off` でも承認のカードの答えのボタンは今のとおり動く（既存のテストが通る）",
		]
	}
	"R-03": {
		title: "質問・判断は、頂点の入力欄に決めた型の下書きを入れるだけ"
		text: """
			［頂点に伝える］を押すと、親が頂点の iframe に postMessage で `{ type: 'orca-web:draft', text }` を送る。text は決めた型：「メンバー〈task の題名〉の質問（ask）に答えてください。」または「…の判断（gate）を決めてください。」に、改行と `（Dispatch <dispatchId>）` を付けたもの。
			`/embed/agent` は、`event.origin` が自分のオリジンで、`event.source` が `window.parent` で、送る欄が出ていて（compose=off でない）、送信の処理中でなく、入力欄が空のときだけ、入力欄にその文を入れる。自動では送らない。空でなければ「入力欄に書きかけがあります」と親に返さず、何もしない（親は押した後に何も起きないことを帯で示さない。入力欄はそのまま）。
			"""
		acceptance: [
			"［頂点に伝える］で、頂点の入力欄に決めた型の文が入り、送信の呼び出しは0回",
			"入力欄に書きかけがあれば上書きしない",
			"別のオリジンや親でない窓からの message は無視する",
		]
	}
}

failures: {
	"F-01": {
		title: "送る経路を足さない"
		text:  "答えは既存の `/embed/agent` のカードと送る欄だけを通る。`compose=off` は送る欄を隠すだけで、門や票は変えない。"
	}
}

constraints: [
	"AGENTS.md の守ること（送る経路を足さない、innerHTML を足さない）",
	"iss-00077・iss-00078 が main に入った後に、その main から始める",
	"「Orca で開く」と枠の作り直しは iss-00077 の部品を使う",
]

decisions: [
	"メンバーの許可待ちは例外として表示し答えられる（利用者、2026-11-25、会話）",
	"下書きは決めた型の文と識別子だけ（質問の本文は拾わない方針、AGENTS.md）",
]
