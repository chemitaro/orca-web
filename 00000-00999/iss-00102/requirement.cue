package spec

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "画面（web/）の表示と配置だけを変える。開く口は既存の /api/open と共有の部品を使い、サーバーと Orca への操作を足さない。PR を戻せば元に戻る"
}

purpose: "指揮の画面（`/`・`/apexes`）を、Orca で開くことを前提としたダッシュボードとして使えるようにする。頂点の一覧の各行から直接「Orca で開く」を押せるようにし、広い幅では一覧と会話がそれぞれのペインの中だけで縦に巻かれ、ページ全体は巻かれないようにする。"

background: """
	利用者の依頼（2026-11-26、会話）：統括の一覧の画面で、一覧の部分に「Orca で開く（Open）」のボタンを置いてほしい。他の Orca で開くことを前提としたダッシュボードとして機能させたい。優先はこちら。
	また、上下のスライダー（縦スクロールバー）が画面によっては右側に3種類重なり、チャットの下に無駄な空間があって、そこへスクロールが発生する。左右に分ける場合、一覧には一覧のスライダー、チャットにはチャットのスライダーとして左右を分けてほしい。すべてが右端に出る状態を避けたい。
	タスク担当の再現（2026-11-26、常駐の orca-web、窓 1920×936）：文書の高さ 1,682px でページが縦に巻かれ、右端にページのスクロールバーが出る。右のペイン（sticky、高さ 100dvh−32px）は見出しの下から始まるため窓の下に 17px はみ出し、その内側に会話の枠（iframe の main）のスクロールバーが並ぶ。一覧（320px）は自分では巻かれず、ページと一緒に動く。
	今の「Orca で開く」：右のペインの見出しに1つだけ（`web/apexes.js` の openControl）。受け箱（`web/inbox-dom.js`）は行ごとに共有の部品と `createOpenBoard` を使い、幅 390px 以下では出さない。
	"""

includes: [
	"頂点の一覧の、選べる頂点の行（apexRow）ごとの「Orca で開く」（共有の部品 `createOpenControl` と `createOpenBoard`、`/api/open`）",
	"幅 900px 以上での、ページの縦の巻きをなくし、一覧と右のペインをそれぞれの中で巻く配置（`web/style.css`）",
]
excludes: [
	"サーバー（`src/`）と `/api/open` の変更",
	"`web/embed/agent.css` など埋め込みの部品の見た目の変更（SpecDock も使うため）",
	"結べない行（結べないエージェント・束）への開くボタン",
	"幅 900px 未満の配置の変更（今の1列のまま）",
]

requirements: {
	"R-01": {
		title: "頂点の行に「Orca で開く」"
		text: """
			頂点の一覧の、選べる行（`selectable` が真）のうち、Orca で開く先（頂点の worktreeId と id）が分かる行に、共有の部品（`web/embed/open-control.js` の `createOpenControl`、size sm）を1つ置く。押すと `/api/open` に `{worktree, agent}` を送る（右のペインの見出しと同じ送り方。トークンは `write.js`）。
			ボタンは行を選ぶボタン（`button[data-apex]`）の外に置き、押しても頂点の選びを変えない。
			開く先が分からない行には置かない。結べない行には置かない。
			描き直しで部品を作り直しても、押した後の途中・結果の表示は、同じ頂点の新しい部品に引き継ぐ（`createOpenBoard`、受け箱と同じ）。
			"""
		acceptance: [
			"worktreeId のある頂点の行に `.orca-open` の部品が1つあり、選ぶボタンの子ではない",
			"押すと `/api/open` に、その頂点の worktree と agent が送られ、選びは変わらない",
			"worktreeId のない頂点の行と、結べない行には部品がない",
			"描き直した後も、押した頂点の部品が途中（busy）か結果の状態を保つ",
		]
	}
	"R-02": {
		title: "狭い幅でも横に流れない"
		text:  "行の Open は、右のペインの見出しと同じく、幅 390px 以下では出さない。行の幅（一覧 320px）の中で、選ぶボタンと「新しいタブで開く」と並んで横に流れない。"
		acceptance: ["幅 390px 以下の media で行の Open が `display: none`", "行の Open は折り返しの中に置かれ、行の幅を広げない"]
	}
	"R-03": {
		title: "広い幅では一覧と会話をそれぞれのペインの中で巻く"
		text: """
			幅 900px 以上では、ページ（文書）は縦に巻かれない。body の高さは窓の高さ（100dvh）に収まり、見出しの下に、左の一覧と右のペインが残りの高さいっぱいに並ぶ。
			左の一覧は、自分の高さを超えたとき一覧の中で縦に巻かれる（スクロールバーは一覧の右の縁、つまり画面の左側に出る）。
			右のペインは残りの高さに収まり、会話の枠（iframe）がペインの下の縁まで届く。窓の下にはみ出さず、会話の下に余白の巻ける空間を作らない。
			一覧の巻きが端に達しても、ページに巻きが移らない（overscroll-behavior: contain）。
			右のペインの見出し（チームの帯・対応のカード）が高いときは、見出しの部分が自分の中で巻かれ、会話の枠に最低限の高さを残す。
			"""
		acceptance: [
			"幅 900px 以上の media で、body が高さ 100dvh・overflow hidden の縦の flex、`.apex-layout` が残りを埋め（flex 1、min-height 0）、`.apex-list` が overflow-y auto・overscroll-behavior contain、`.apex-pane` が sticky でなく高さがレイアウトに収まる",
			"実物の画面（窓 1920×936 程度）で、文書の scrollHeight が窓の高さを超えない。一覧が長いときは `.apex-list` の scrollHeight が clientHeight を超え、その中で巻ける。右のペインの下の縁が窓の中にある",
		]
	}
	"R-04": {
		title: "狭い幅の配置は今のまま"
		text:  "幅 900px 未満では、今の1列の配置（選んでいなければ一覧、選んでいれば右のペインだけ）を変えない。"
		acceptance: ["900px 未満の media の既存の規則（apexes-navigation の試験）がそのまま通る"]
	}
}

failures: {
	"F-01": {title: "開けない", text: "開く口の失敗・時間切れは、共有の部品の今の表示（error と理由）に任せ、選びや一覧の表示を変えない。"}
}

constraints: [
	"AGENTS.md：「Orca で開く」は共有の部品1つで、二重に持たない。DOM は textContent だけ。タブやファイルを作る操作を足さない",
	"実行時の依存を足さない。ビルドしない素の ES Modules",
]
decisions: [
	"一覧の各行に Orca で開くボタンを置き、ダッシュボードとして使う。優先する（利用者、2026-11-26、会話）",
	"一覧と会話のスクロールバーを左右に分け、すべてが右端に出る状態を避ける（利用者、2026-11-26、会話）",
	"コーディングは Codex を使わず Opus 5.5 で行う（利用者、2026-11-26、会話）",
	"親の epic-00090 が閉じているため、init-00002 の下に epic-00101 を作って親にした（タスク担当、2026-11-26）",
	"行の Open は頂点（選べる行）だけ。結べない行は開く先の確かさが低いので置かない（タスク担当、2026-11-26）",
]
