package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "画面と読み取りの判定が中心で、送信の経路は既存のものを使う。誤判定は利用者の気づきを遅らせるが、Orca の状態は変えない"
}

purpose: "orca-web を、SpecDock の部品としてだけでなく単独で使える「オーケストレーター（親のない頂点のエージェント）を、チャットで指揮・監督する画面」にする。人は頂点だけを管理し、頂点ごとに「対応が必要」「作業中」「完了」が一目で分かり、配下の構成と動きを階層で見て、頂点とチャットして指示できる。"

background: """
	Orca 公式の画面は worktree とタブの並びで、どの統括が何を指揮しているか、いま誰の番かを持たない。今の orca-web も受け箱は役割を問わず done を「終わった」に畳み（`src/inbox/classify.ts`）、Run の木は統括をほとんどエージェントに結べない（2026-11-25 の実データで Run 18 のうち 0、木 17 本のうち根が結べたのは 1）。通知もない。

	分析は 2026-11-25 に Fable 5.2（3本）と Opus 5.5 のレビュアー（2本）で行った。材料と第2版の設計は、タスク担当の Workbench `.workbench/orchestrator-ui/`（`proposal-v2.md`）にある。
	"""

includes: [
	"頂点の一覧と状態の判定の API と画面",
	"頂点と配下の結び（台帳なし、メモリだけ）",
	"頂点の会話を同じ画面で開き、頂点に送る",
	"チームの階層と多数の Dispatch の見せ方",
	"対応のカード（メンバーの許可待ちへの答え、質問・判断の頂点への下書き）",
	"気づかせ方（タブの題名の件数、favicon、デスクトップの通知）",
	"`/` の差し替えと、受け箱・Run の木の入れ替え",
]
excludes: [
	"スマホへの通知（Tailscale の http は安全なコンテキストでないため。利用者の 2026-11-25 の判断で当面考えない）",
	"永続の台帳（利用者の判断）",
	"orca-web から Orca の gate・ask に直接答える経路、エージェントや worktree を作る操作、一斉送信",
	"Orca 本体の変更（統括の識別子の公開は Orca への要望として扱う）",
]

requirements: {
	"R-01": {
		title: "一覧の単位は親のない頂点だけで、配下は頂点に含める"
		text:  "頂点は、`parentPaneKey` の親が今あるエージェントに見つからず、Orca の worker の記録にも結ばれないエージェント。単独で動くエージェントも頂点。作業者と途中のタスク担当（メンバー）は一覧に出さず、頂点の中にだけ出す。"
		acceptance: [
			"状態の文書の各エージェントが、頂点かメンバーのどちらか1つに入る（親の見つからない子は頂点にせず「結べない仕事」へ）",
			"一覧の行は頂点だけで、各行に配下の数（動いている/全体）が出る",
		]
	}
	"R-02": {
		title: "頂点の状態は「対応が必要」「作業中」「完了」の3つで、配下を含めて決まる"
		text:  "配下の誰かが動いていれば、頂点自身が done でも作業中。完了は「完了だと分かる証拠があるとき」だけ。理由は小さな札で添える。"
		acceptance: [
			"頂点が done で、配下に working のメンバーがいる頂点が「作業中」になる",
			"頂点かメンバー（タブが attached）が許可待ち・入力待ちのとき「対応が必要」になる（メンバーは 20 秒の猶予の後。利用者の 2026-11-25 の判断で例外として出す）",
		]
	}
	"R-03": {
		title: "読めない・古いときは完了にしない"
		text:  "状態が不明のエージェントや、Orca の取得元が古い間は、状態を「完了」へ動かさず、「確かめられない」の札を付ける。"
		acceptance: [
			"state が null で復元待ちでない頂点（配下なし）は完了にならず、札「確かめられない」が付く。24 時間動きがなければ「眠っている」に畳む（state が null で復元待ちの頂点は、タブが復元されず動いていないので眠っている）",
			"取得元が stale の間、作業中・対応が必要から完了へ移らない",
		]
	}
	"R-04": {
		title: "頂点と配下を、閉じた子も含めて台帳なしで結ぶ"
		text:  "生きた辺（parentPaneKey）、Run の今の世代（consumer_generation）、task の作成者（created_by_pane_key・created_by_run_generation）で結ぶ。構造化 Chat の統括の対応はメモリだけに持ち、捨てる条件を決める。結べないものは「結べない仕事」に出す。"
		acceptance: [
			"子のタブが閉じた後も、端末の統括は根の task の作成者で配下の履歴と結ばれる",
			"「結べない仕事」には、生きた Dispatch か未解決の問いがあるものだけが出る",
		]
	}
	"R-05": {
		title: "対応が必要の理由を、質問・判断・止まった仕事・失敗・統括不在まで判定する"
		acceptance: [
			"未回答の ask、未解決の gate、報告のない作業者、起こされない統括、新しい失敗、統括のタブが閉じたのに生きた仕事がある、がそれぞれ理由の札付きで「対応が必要」になる",
			"放置された古い task（ready・pending・gate のない blocked）だけでは「対応が必要」にならない",
		]
	}
	"R-06": {
		title: "完了の後のフォローを、確認の操作なしで表す"
		text:  "「拾った」のような確認の操作は作らない（利用者の 2026-11-25 の判断）。残りの札、新着の点、時間で畳む、で表す。"
		acceptance: [
			"完了してからまだ見ていない頂点に新着の点が付き、その頂点を開いて見ると消える",
			"24 時間より古い完了は「以前の完了」に、仕事のない復元待ちは「眠っている」に畳まれる",
		]
	}
	"R-07": {
		title: "頂点の会話を一覧と同じ画面で開き、頂点にだけ送れる"
		acceptance: [
			"一覧で頂点を選ぶと、同じ画面に頂点の会話が出て、入力欄から頂点へ送れる",
			"メンバーには入力欄を出さない",
		]
	}
	"R-08": {
		title: "チームの階層と、多数の Dispatch の結果を見せる"
		acceptance: [
			"チームのある頂点で、頂点→子→孫の階層が途中のタスク担当も含めて見える",
			"配下が 100 を超えても、動いている節と最近の失敗が1画面に出て、残りは履歴の帯にまとまる",
		]
	}
	"R-09": {
		title: "メンバーの許可待ちに頂点の画面から答え、質問・判断は頂点への下書きにする"
		acceptance: [
			"メンバーの許可待ちのカードから、既存の承認の経路でそのメンバーに答えられる",
			"メンバーの質問・判断のカードは、頂点の入力欄に決めた型の下書きを入れるだけで、自動では送らない",
		]
	}
	"R-10": {
		title: "対応が必要になったことに気づける"
		acceptance: [
			"タブの題名に対応が必要の件数が出て、favicon が変わる",
			"127.0.0.1 の画面で許可したとき、対応が必要に入った頂点ごとに1回だけデスクトップの通知が出る",
		]
	}
	"R-11": {
		title: "指揮の画面を `/` にし、今ある画面は観点の1つとして残す"
		acceptance: [
			"`/` が指揮の画面で、受け箱は `/inbox` で今のとおり動く",
			"Run の木の根が、新しい結び方で頂点に結ばれる",
		]
	}
}

failures: {
	"F-01": {
		title: "内部に持つ値は捨てる"
		text:  "結びの対応表などのメモリの値は、頂点が消えたとき、束が終わって 24 時間、再起動で捨てる。ファイルに書かない。"
	}
	"F-02": {
		title: "送信の安全策を壊さない"
		text:  "送る経路と再送の道を足さない。意図→確定、宛先の指紋、使い捨ての票、結果不明は送り直さない、を新しい画面でも保つ。"
	}
	"F-03": {
		title: "SpecDock との契約を変えない"
		text:  "`/embed/*`、`/api/state`（`orca-web.state/v1`）、`/api/worktrees/summary` の形と意味を変えない。新しく読む項目は新しい API の中だけに出す。"
	}
	"F-04": {
		title: "Orca に届かない・負荷が高いときに誤った通知を出さない"
		text:  "同じ移り変わりが2回続けて読めたときだけ通知し、届かない状態から戻った直後は出さない。"
	}
}

constraints: [
	"AGENTS.md の守ること（Orca へは許された操作のほか読む要求だけ、innerHTML を足さない、実行時の依存を足さない）",
	"実装とレビューは Anthropic の Opus 5.5 を使い、Codex の GPT-6.2 Sol・Astra は使わない（利用者の 2026-11-25 の指示）",
]

decisions: [
	"管理の単位は親のない頂点だけ。配下は頂点に含める（利用者、2026-11-25、会話）",
	"状態は3つ。配下が動いていれば頂点は作業中（利用者、2026-11-25、会話）",
	"台帳を作らない。内部の値は定期的に捨てる（利用者、2026-11-25、会話）",
	"「拾った」は作らない（利用者が意味を分かりにくいとし、タスク担当が残りの札・新着の点・時間で代えると提案、2026-11-25）",
	"メンバーの許可待ちは、基本は統括がさばくが、さばかれず止まることもあるので例外として表示し答えられる（利用者、2026-11-25、会話）",
	"構造化 Chat の結びが切れたら「結べない仕事」に出し、Orca 本体に統括の識別子の公開を要望する（利用者が推奨案を採用、2026-11-25）",
	"AGENTS.md の「同じ iframe の中で別のエージェントへ移らない」の文言を、外の画面が枠を作り直す形に合わせて書き換えてよい（利用者、2026-11-25、会話）",
	"スマホへの通知は当面考えない（利用者、2026-11-25、会話）",
	"state が null で復元待ちの頂点は「動いていない」証拠があるものとして眠っている（完了）に入れる（タスク担当、2026-11-25、iss-00076 の仕様レビューの P2 への対応）",
]

questions: [
	"構造化 Chat の /clear で paneKey が変わるか、run-use の後の consumer_generation と task の作成者の関係（iss-00078 の実機の確かめで決める）",
]
