package spec

schema: "specdock/v1"

assurance: {
	level:  "light"
	reason: "画面の表示と通知だけで、Orca の状態は変えない"
}

purpose: "指揮の画面（`/apexes`）を開いている間、頂点が「対応が必要」に入ったことに、タブの題名・favicon・デスクトップの通知で気づける。"

background: """
	Epic epic-00075 の切り分け（R-10、F-04）。題名の件数は iss-00076 で入った。スマホへの通知は利用者の判断で当面考えない（Tailscale の http は安全なコンテキストでなく、Web Notification が使えない）。
	Opus 5.5 のレビュアーの指摘（2026-11-25）：index の画面の CSP は `default-src 'self'` なので favicon は data: でなく静的なファイルにする。通知の本文に最後の一言を入れると macOS の通知に残る。見えないタブのタイマーは約1分に間引かれる。SSE は足さずポーリングにする（同じホストへの接続の上限）。
	"""

includes: [
	"favicon（静的な SVG を2つ、対応が必要があるときに差し替える）",
	"デスクトップの通知（Web Notification）と、許可を求めるボタン",
	"通知の重複と誤報の抑え（2回続けて読めた移り変わりだけ、古い文書や読めない状態から戻った直後は出さない）",
	"README の追記",
]
excludes: [
	"スマホへの通知、外のサービスへの通知、音",
	"SSE の追加",
	"/apexes 以外の画面の通知",
]

requirements: {
	"R-01": {
		title: "favicon で対応が必要に気づける"
		acceptance: [
			"対応が必要が1つ以上なら favicon が印付きの SVG、0なら普通の SVG になる",
		]
	}
	"R-02": {
		title: "対応が必要に入った頂点ごとに1回だけデスクトップの通知を出す"
		text: """
			- 通知の同一性：頂点の id と、その頂点の理由の集合（並べた文字列）。同じ同一性では、画面を開いている間に1回だけ。
			- 知っている同一性の集合 K：画面を開いた後、stale でない最初の2回の読みに出た needs_action の同一性はすべて K に入れる（開いた時点で既に対応が必要なものは知らせない）。出した同一性も K に入れる。K の同一性が stale でない読みで2回続けて出なければ K から外す（対応が必要から出て、また入れば知らせ直す）。
			- 出す条件：通知の許可が granted、出すときに `document.hidden` が真、今の文書と1つ前の stale でない文書の両方で同じ同一性が needs_action で、その間に stale の文書を挟まず、同一性が K にない。stale の文書を受けたとき、または読みが失敗した（fetch の誤り、!res.ok、形の誤り）ときは、続けて読めた数を0に戻す（K はそのまま）。
			- 見えない間の読み：iss-00076 は見えない間の読みを止めるが、通知の許可が granted のときだけ、見えない間も 30 秒ごとに読む（見えるときは今の 10 秒）。許可がないときは今のとおり止める。
			- 本文：頂点の題名（なければ「頂点」）と理由の言葉だけ。最後の一言、パス、会話を入れない。
			- 押すと、窓を前に出し、その頂点を選ぶ（iss-00077 の選択があればそれを使い、なければ `?apex=` を付けて開き直す）。
			"""
		acceptance: [
			"対応が必要に入った頂点が2回続けて読めると1回だけ通知が出る。1回だけでは出ない",
			"stale の文書を挟んだ直後や、開いて最初の2回の読みでは出ない。開いた時点で既に対応が必要の頂点では出ない",
			"通知を許可したタブを隠すと 30 秒ごとに読み続け、隠れている間に対応が必要に入った頂点の通知が出る",
			"対応が必要から出て2回読めた後にまた入った頂点では、もう一度通知が出る",
		]
	}
	"R-03": {
		title: "許可は利用者のボタンで求め、使えない環境では出さない"
		text:  "Notification がない、`isSecureContext` が偽（Tailscale の http など）、許可が denied のときはボタンを出さず、題名と favicon だけで知らせる。許可が default のとき、見出しに「通知を許可」のボタンを出し、押したときだけ `Notification.requestPermission()` を呼ぶ。"
		acceptance: [
			"isSecureContext が偽ならボタンも通知もない",
		]
	}
}

failures: {
	"F-01": {
		title: "Orca に届かない・負荷が高いときに誤って通知しない"
		text:  "R-02 の条件のとおり、stale の文書が1つでも挟まれば、その後の2回の読みまで通知しない。"
	}
}

constraints: [
	"AGENTS.md の守ること（innerHTML を足さない、実行時の依存を足さない）",
	"通知の本文に会話・最後の一言・パスを入れない",
]

decisions: [
	"SSE を足さず、ポーリング（10 秒、見えないタブは間引かれて最大約1分遅れる）で決める（Opus 5.5 のレビュアーの提案をタスク担当が採用、2026-11-25）",
	"通知は /apexes を開いている間だけ（ページを閉じると通知は出ない）",
]
