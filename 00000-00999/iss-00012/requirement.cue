package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

// 型の版。消さない。
schema: "specdock/v1"

assurance: {
	level:  "strict"
	reason: "信頼しない会話の本文を描く画面（XSS の境界）で、別のオリジンに埋め込まれる。別の会話を混ぜると、後の送信（iss-00013）で誤った前提の指示につながる"
}

purpose: """
	利用者が、Orca で動くエージェント（端末の Claude Code と Codex、構造化 Chat）の詳細と会話のログを、orca-web の1つの画面で読めるようにする。
	会話のログの API（ページの読み取りと、変化を受ける口）と、エージェントの詳細とチャットの画面 `/embed/agent?id=…`（読むだけ）を作る。
	この画面は、orca-web の単独の画面（受け箱、状態の画面）と、SpecDock の埋め込みの両方で使う。送信は作らない（iss-00013）。
	"""

background: """
	親の epic-00004 の切り分け（slices の iss-00012。covers は R-01 と F-05）を受け、Epic の D-01（会話のログの API）と、D-05 の描画を具体にする。
	2026-11-13 に、SpecDock へ渡す部品が3つ（稼働の印、Orca で開く、詳細とチャット）に決まり、この Issue の画面はその「詳細とチャット」になった（init-00002 の R-07、D-08）。
	iss-00005 の実機の確かめで、`nativeChat.readSession` は Claude 9 件と Codex 1 件のすべてで読めた。Orca のソースは、この Mac の版のタグ v1.4.256 を根拠にする。
	"""

includes: [
	"Orca が持つ会話の記録（端末のエージェントは `nativeChat.readSession`、構造化 Chat は `agentSession.history`）を、状態の API のエージェントの id から読むアダプター",
	"会話の正規化（`orca-web.transcript/v1`）、`GET /api/transcript`（とページング）、変化を受ける口 `GET /api/transcript/events`（SSE）",
	"エージェントの詳細とチャットの画面 `/embed/agent?id=…`（読むだけ）と、状態の画面からの開き方",
	"この Mac の Orca での読むだけの実機の確かめと、report.md への記録",
]

excludes: [
	"送信の欄、送る意図と確かめ、送信の記録（iss-00013）。送信の欄は見た目だけでも置かない",
	"SpecDock のオリジンの試しの画面での受け入れ、postMessage（iss-00014）",
	"稼働の印の要約の API（iss-00019）",
	"ペアリングした WebSocket での購読（init-00002 の対象外）",
	"端末の画面（scrollback）からの会話の組み立て",
	"受け箱、オーケストレーションの木（epic-00016）",
]

requirements: {
	"R-01": {
		title: "利用者（と画面）が、エージェントの id で、その会話のログを正規化した形で読める"
		text: """
			`GET /api/transcript?agent=<状態の API のエージェントの id>` が、Orca が今そのエージェントに結んでいるセッションの会話の末尾を返す。
			`limit` で件数を選べ、`before`（前の応答が返した不透明な位置。セッションの鍵を含む）で、より古いページを読める。
			各件は、役割（user、assistant、tool）、時刻、部品（本文、ツールの呼び出し、ツールの結果、表示できない印）を持つ。
			思考（reasoning）は、印も付けずに出さない。「表示できない」の印は、未対応の部分（画像、未知のブロックなど）だけに付ける。
			並びは Orca の画面と同じにする（端末のエージェントは Orca の画面と同じ引数で読み、返る順のまま。構造化 Chat は journal の位置の順）。
			セッションの識別子と記録のパスは Orca が持つものを使い、ファイルの名前から作らない。記録のパスと Orca の誤りの文は応答に出さない。
			"""
		acceptance: [
			"録画した会話から、本文、ツールの呼び出しと結果、未対応の部分の印（画像、未知のブロック）が返り、思考の件が返らない",
			"`before` で、前のページと重ならない、より古いページが返る",
			"応答に、記録のパス、authToken、Orca の誤りの文が含まれない",
		]
	}
	"R-02": {
		title: "画面が、会話の変化を、追記と置き換えに分けて受けられる"
		text: """
			`GET /api/transcript/events?agent=…`（Server-Sent Events）が、最初に今の窓（snapshot）を送り、その後は、末尾に足された件と、窓の中で同じ id のまま中身が変わった件（appended）か、
			窓の全体の置き換え（replacement。記録の書き換え、巻き戻し、別のセッションへの切り替え、読めない状態からの回復）を送る。
			読めなくなったら unavailable を送る。同じエージェントを見る画面は、サーバーの1つの読みを共有し、見る人がいなくなったら読みを止める。
			"""
		acceptance: [
			"録画の再生で、件が足されると appended だけが届き、記録が書き換わると replacement が届き、古い表示の件が残らない",
			"同じエージェントの2つの購読が、Orca への読みを共有し、最後の購読が閉じると読みが止まる",
			"同時に見るエージェントの数と購読の数に上限があり、超えると理由を示して断る",
		]
	}
	"R-03": {
		title: "利用者が、エージェントの詳細とチャットの画面で、エージェントの様子と会話を読める"
		text: """
			`/embed/agent?id=…` の画面が、上に詳細を、下に会話を示す。
			詳細：題名、worktree（ブランチ）、エージェントの種類、状態と開始時刻、モデルと推論（値の意味を付ける。取れなければ「取れない」と理由）、親と子のエージェント、PR と CI、Orca で開くボタン（幅 390px 以下では出さない）。
			会話：指示と返答の本文を吹き出しで並べ、ツールの呼び出しと結果を折り畳んで示し、未対応の部分にだけ「表示できない」と示す。思考は出さない。前のページを読む操作がある。
			本文は textContent で描き、HTML として解釈しない。幅 390px で横にはみ出さずに読める。送信の欄は出さない。
			"""
		acceptance: [
			"録画した状態と会話を描くと、詳細の項目、本文の吹き出し、折り畳んだツールが出て、思考が出ない（画面の組み立ての純粋な関数のテスト）",
			"`<script>` や `<img onerror>` を含む本文とツールの出力が、文字のまま描かれ、要素にならない",
			"実機で、幅 390px の表示で横にはみ出さずに読め、Orca で開くボタンが出ない",
		]
	}
	"R-04": {
		title: "利用者が、今の状態の画面からエージェントを選び、詳細とチャットの画面を開ける"
		text:  "状態の画面のエージェントの表の各行に、そのエージェントの `/embed/agent?id=…` を新しいタブで開くリンクを置く。"
		acceptance: ["エージェントの表の各行に、id を URL の符号にした詳細とチャットの画面へのリンクがある"]
	}
	"R-05": {
		title: "画面を SpecDock のオリジンからだけ iframe に埋め込める"
		text:  "`/embed/agent` は、既存の埋め込みの画面と同じ CSP（frame-ancestors は設定した SpecDock のオリジンだけ。なければ 'none'）で配る。会話の API は同じオリジンからだけ読ませる。"
		acceptance: ["`/embed/agent` の応答の CSP の frame-ancestors が、設定した読み取りのオリジンだけで、inline の script と style を許さない"]
	}
	"R-06": {
		title: "この Mac の Orca で、Claude Code と Codex の会話を、Orca の画面と同じ順で読めることが確かめられている"
		text: """
			読むだけの実機の確かめで、Claude Code と Codex（と、あれば構造化 Chat）の会話を API で読み、並びが Orca の画面と同じ読み方で返る順のままであることを確かめる。
			購読の口が Unix ソケットで使えないことは、手元の版のソースで確かめる。件数と結論だけを report.md に書く。会話の中身は、録画、report.md、ログに写さない。
			"""
		acceptance: ["report.md に、Orca の版、読めた会話の数（Claude と Codex）、並びの確かめ、購読の口の確かめの結論が、件数だけで書かれている"]
	}
}

failures: {
	"F-01": {
		title: "会話の記録が読めないとき、空の会話ではなく「読めない」と理由を示す"
		text: """
			エージェントが見つからない、Orca がそのエージェントにセッションを結んでいない（スリープ中、まだ指示を受けていない）、記録のファイルがまだない、
			機能が使えない、Orca に届かない、読みが失敗した、知らない形の応答、のそれぞれを、区別できる誤りの code で返し、画面は「読めない」と理由を示す。
			空の会話（0件）を示すのは、Orca が読めたうえで0件を返したときだけにする。
			"""
		impact:   "利用者が、読めないのを会話がないと取り違え、状態を誤って判断する"
		recovery: "理由を示し、Orca の画面で確かめるよう促す。読めるようになったら、画面は全体を置き換えて描き直す"
	}
	"F-02": {
		title: "別の会話を混ぜない"
		text: """
			窓と差分は、エージェントの id、取得元、エージェントの種類、セッションの識別子の組（セッションの鍵）ごとに持つ。同じ枠でセッションが変わったら、追記ではなく置き換えを送る。
			古いページの読みは、要求の位置に含まれるセッションの鍵が今のセッションと違えば、読まずに断る（409）。画面は、置き換えを受けたら、それまでの件（前のページを含む）をすべて捨てる。
			"""
		impact:   "別の会話の件が混ざり、利用者が誤った前提で判断や指示をする"
		recovery: "置き換えで描き直す。混ざった表示が見つかったら、画面を開き直す"
	}
	"F-03": {
		title: "会話の本文、ツールの出力、Orca の題名や PR の値を、信頼しないデータとして描く"
		text: """
			本文、ツールの名前、入力、出力、題名は textContent でだけ描く。PR へのリンクは `https:` の URL だけをリンクにする。
			画面は inline の script と style を許さない CSP で配る。会話の API は同じオリジンからだけ読ませ、読み取りの CORS を付けない。
			"""
		impact:   "本文に紛れた HTML やスクリプトが動き、画面の権限（開く口の短期のトークン）で操作が行われる"
		recovery: "描き方を直して配り直す"
	}
}

constraints: [
	"Orca には読む要求だけを送る（`session.tabs.listAll`、`nativeChat.readSession`、`agentSession.history`）。送信と開く口は、利用者が画面の「Orca で開く」を押したときの既存の開く口のほかは呼ばない",
	"Orca の authToken、会話の記録のパス（家のディレクトリを含む）を、応答、画面、ログ、録画に出さない",
	"録画の fixture は、自分で作った仮の会話にする",
	"実行時の依存を足さない",
]

decisions: [
	"2026-11-06 画面の描画はこの Issue が持つ（epic-00004 の仕様のレビュー round 1 の指摘で、Epic の D-05 を R-01 に結び付け直した）",
	"2026-11-06 思考は印も付けずに出さない。「表示できない」の印は、未対応の部分（画像、未知のブロックなど）だけに付ける（同 P3）",
	"2026-11-13 画面は `/embed/agent?id=…` の詳細とチャット（Epic の R-04、init-00002 の D-08）。前の下書きの `/embed/chat` はやめる",
	"2026-11-13 保証レベルを standard から strict に上げる（親の Epic と同じ。XSS の境界と会話の同一性）",
	"2026-11-13 Orca 1.4.256 の Unix ソケットは、streaming の method（`nativeChat.subscribe`、`agentSession.subscribe`）を `method_not_supported` で拒む（ソースの `runtime-rpc-request-admission.ts` が `dispatcher.dispatch` だけを呼び、`dispatcher.ts` が streaming の method を通さない）。購読はペアリングした WebSocket だけで、ペアリングは init-00002 の対象外。そこで、サーバーが末尾を短い間隔で読み直し、前の窓との差から追記と置き換えを作って SSE で配る。epic-00004 D-01 の「購読の口が使えないときは末尾を読み直す」に当たる",
	"2026-11-13 `nativeChat.readSession` に、Orca の画面と同じ `capabilities: { transcriptSourceOrder: 1 }` を渡し、返る順のまま並べる（Orca のデスクトップの読み取りも sourceOrder を使う）",
	"2026-11-13 会話の API は同じオリジンだけ（画面は orca-web のオリジンの iframe の中から読む）。状態の API と違い、SpecDock のオリジンに読み取りの CORS を許さない",
	"2026-11-13 構造化 Chat の turn、agent-start、agent-handoff の件は会話の本文ではないので出さない。diff、approval、question、status、plan、知らない kind は「表示できない」の印にする",
	"2026-11-13 実機の確かめでは `nativeChat.subscribe` を送らない（読む RPC の一覧を広げない）。購読の口の結論はソースで確かめる",
]
