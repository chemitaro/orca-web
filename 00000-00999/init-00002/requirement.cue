package spec

// 要件（Initiative）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "単独利用の手元サービス。書き込み（開く・送る）の誤りは Orca の画面で戻せるが、誤送信の防止は要る"
}

purpose: """
	Orca（stablyai/orca、この Mac のデスクトップアプリ）の状態を読み、操作する小さな独立の Web サービス orca-web を作る。
	SpecDock のダッシュボード（と company-os のダッシュボード）に部品として埋め込み、ダッシュボードを能動的にする。
	SpecDock 自身は見るだけのまま、Orca を触るのは orca-web だけにする。
	"""

background: """
	SpecDock の epic-00471（図への Orca の状態の重ね）と epic-00526（チャットの埋め込み）の土台。
	2026-10-25 の試作（worktrees/orca/orca-link-url-trial）で、内部の口でタブを前面に出せることを確かめた。
	公式の Orca Web は、特定のセッションを URL で開けず、埋め込むには大きすぎるため採用しない（2026-11-06 の利用者の判断）。
	"""

includes: [
	"Orca の repo・worktree・エージェント・オーケストレーションの状態を読む API",
	"この Mac の Orca で既存のタブを前面に出す「Orca で開く」（単独で再利用できる部品と開く口）",
	"会話のログをチャットの形で読み、確認したうえで指示を送る軽い小窓",
	"launchd での常駐と、127.0.0.1 と Tailscale のアドレスでの待ち受け",
]

excludes: [
	"Scope と worktree の対応の決定（SpecDock 側が決める）",
	"SpecDock のダッシュボードへの組み込みそのもの（SpecDock の epic-00471・epic-00526）",
	"公式の Orca Web の利用、ペアリング",
	"複数のホストや複数の利用者、追加のログイン",
	"エージェントの起動・停止、権限の承認の代行",
]

requirements: {
	"R-01": {
		title: "利用者が Orca の状態を、取れる項目から選んで見られる"
		text: """
			エージェントの種類（Claude Code、Codex など）、状態（作業中・待ち・完了・スリープなど）、状態の開始時刻と最後に動いた時刻、
			作業の題名、親と子のエージェント、つながった PR と CI を返す。モデルと推論レベルは、取れるとき（オーケストレーションの担当の起動値、
			エージェントの状態の model など）だけ、どの意味の値か（起動の要求、起動時の解決、現在の選択、最後の観測）を付けて返す。
			取れない情報は「取れない」と示し、別の値から作らない。表示する項目は利用者が選べる。
			"""
		acceptance: [
			"Orca で動く Claude Code と Codex とオーケストレーションの担当について、種類・状態・時刻・題名・親子・PR と CI が返る",
			"モデルと推論レベルは、値の意味と取得元が付いて返るか、取れないことが示される",
			"表示する項目を選ぶと、選んだ項目だけが表示される",
		]
	}
	"R-02": {
		title: "SpecDock が worktree を Scope に結び付けられる"
		text:  "worktree のパスとブランチと識別子を、SpecDock が Scope に結び付けられる形で返す。どの Scope に当たるかは SpecDock が決める。"
		acceptance: ["状態の API が worktree ごとにパス・ブランチ・識別子を返し、SpecDock の読み取りのオリジンから読める"]
	}
	"R-03": {
		title: "利用者が「Orca で開く」で、この Mac の Orca の該当のタブを前面に出せる"
		text: """
			指定の worktree（またはエージェント）について、最後に動いたエージェントのタブ、なければ最後に見ていたタブ、
			それもなければ worktree だけを前面に出す。新しいタブやファイルは作らない。スリープ中のエージェントは、Orca の画面で
			クリックしたときと同じく復元してよい。スマホではこのボタンを出さない。
			"""
		acceptance: [
			"Mac のブラウザーで押すと、Orca が前面に出て、該当のタブが選ばれる",
			"開けないときに新しいタブやファイルを作らず、開けなかったことが示される",
			"スマホの幅ではボタンが出ない",
		]
	}
	"R-04": {
		title: "「Orca で開く」を単独で再利用できる"
		text:  "状態の表示やチャットと切り離し、SpecDock のダッシュボードなど別の画面が、ボタンだけ（または開く口だけ）を使える。"
		acceptance: ["チャットや状態の画面を読み込まずに、ボタンの部品だけを別のオリジンの画面に置いて開ける"]
	}
	"R-05": {
		title: "利用者がエージェントの会話のログを、チャットの形で読める"
		text: """
			指示と返答の本文を吹き出しで並べ、ツールの呼び出しと結果は折り畳む。思考は出さない。端末の画面から会話を組み立てない。
			別の会話を混ぜない。PC とスマホ（幅 390px）で読める。
			"""
		acceptance: [
			"Claude Code と Codex の会話が、本文の吹き出しと折り畳んだツールで表示される",
			"取れないときは空の会話ではなく「読めない」と示される",
			"幅 390px で読める",
		]
	}
	"R-06": {
		title: "利用者が、確かめたうえでエージェントに指示を送れる"
		text: """
			送る前に宛先（リポジトリ、worktree、エージェントの種類、題名、状態）と本文を示して確かめる。作業中のエージェントにも送れる。
			送ったら、宛先・時刻・本文・結果をこの Mac の中だけに記録する。PC とスマホから送れる。
			"""
		acceptance: [
			"確認の画面に宛先と本文が出て、確定するとその宛先にだけ届く",
			"送った記録に、宛先・時刻・本文・結果が残る",
		]
	}
	"R-07": {
		title: "SpecDock のダッシュボードに、状態と開くボタンとチャットを埋め込める"
		text:  "状態は読み取りの JSON として、チャットは orca-web の画面の iframe として、SpecDock の画面に入る。スマホでも使える。"
		acceptance: ["SpecDock の別のオリジンの画面から、状態を読み、チャットの iframe を表示し、送信まで行える"]
	}
	"R-08": {
		title: "この Mac で常駐し、手元と tailnet からだけ使える"
		text:  "launchd の利用者のサービスとして常駐する。127.0.0.1 と、指定した Tailscale の IP だけで待ち受ける。"
		acceptance: ["再起動の後も動き、127.0.0.1 と Tailscale の IP 以外からはつながらない"]
	}
}

failures: {
	"F-01": {title: "Orca が動いていない、ランタイムにつながらないときは、画面を止めず「Orca に接続できない」と示す"}
	"F-02": {title: "Orca の更新で CLI や内部の口の形が変わったときは、読めない項目だけを落として示し、確かめられない書き込み（開く・送る）はしない"}
	"F-03": {title: "宛先が確認のときから変わったとき、権限の確認待ちなど送ると誤動作するときは、送らずに確かめ直す。結果が分からない送信を新しい要求として送り直さない"}
	"F-04": {title: "別のオリジン、許していない Host、古い確認からの書き込みを受け付けない"}
}

constraints: [
	"Orca のランタイムはこの Mac の1台だけ。使う人は利用者だけ。tailnet の端末は利用者のもので、追加のログインは要らない",
	"Orca の認証の情報（runtime の authToken、ペアリングのコード）を記録、URL、画面、ログに出さない",
	"表示するタイトル、ログ、ツールの出力は信頼しないデータとして扱う",
]

decisions: [
	"2026-11-06 公式の Orca Web は採用しない",
	"2026-11-06 「Orca で開く」はこの Mac のデスクトップアプリで開く。スマホでは隠す。スリープ中は復元してよい",
	"2026-11-06 チャットは自作の軽い部品。ログは本文中心、ツールは折り畳み、思考は出さない",
	"2026-11-06 作業中のエージェントにも区別せず送る（ChatGPT の『拒否』の推奨より利用者の判断を優先）",
	"2026-11-06 送信の記録は宛先・時刻・本文を Mac の中だけに残す",
	"2026-11-06 リポジトリ chemitaro/orca-web は公開",
]
