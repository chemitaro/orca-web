package spec

// 要件（Issue）。型 specdock/v1。書き方は spec-dock/docs/authoring/ のガイドにある。

// 型の版。消さない。
schema: "specdock/v1"

assurance: {
	level:  "strict"
	reason: "確認の段をなくすと、誤送信を送る前に止める機会が減る。誤送信と二重送信は取り消せず、作業を壊しうる"
}

purpose: """
	`/embed/agent?id=…`（エージェントの詳細とチャットの小窓）を、ChatGPT・Claude・Orca のアプリと同じような、普通のシンプルなチャットにする。
	詳細は既定で畳み、入力欄に書いて Enter で送る。確かめるボタン、確認の画面、期限の表示はなくす。
	宛先の確かめ、二重送信の防止、結果不明の照会、送信の記録、`sendEnabled`、書き込みの守りは、画面に出さずに内部で保つ。
	"""

background: """
	本人の確かめ（2026-11-14、iss-00014 の report.md の『## 本人の確かめ』）で、詳細とチャットの部品は動くが使い勝手がいまいちとされた。
	直すこと：詳細の部分は既定で畳み、開きたいときに開く。Enter で送り、Shift+Enter で改行する（本人は「スペースエンター」と話した。音声入力の誤りと読み、一般的なチャットの Shift+Enter とする。統括の依頼書）。
	確かめるボタン、『この文章を送ります』の確認、60 秒の期限はいらない。Orca の UI とほぼ同じでよい。
	部品は SpecDock の構造の図や Issue の一覧の狭い枠に埋め込む前提（SpecDock 側の組み込みは spec-dock の epic-00471・00526 で後に行う）。

	今の形（iss-00013、確かめたこと）：画面は「確かめる」で `POST /api/send/intent`（宛先を固定し、60 秒の使い捨ての票を返す）を送り、確認の画面（リポジトリ、worktree、ブランチ、種類、題名、状態、経路、セッション、本文、期限）を出し、「送る」で `POST /api/send/confirm`（宛先、世代、本文、送れる状態を確かめ直して1回だけ送る）を送る。
	サーバーの守り（`src/send/service.ts` の preflight：tabs.listAll から宛先を解き、端末は terminal.agentStatus と terminal.inspectProcess で前面のプロセスが宛先のエージェントそのものか、ptyId・incarnation・providerSession が同じかを確かめる。送る前の記録を書けなければ送らない。結果不明は `GET /api/send/{操作の ID}` で照会するだけで送り直さない）は、この Issue で変えずに使う。
	Orca 1.4.258 の入力欄（アプリの中の画面のコードで確かめた）：デスクトップは Enter で送り、Shift+Enter と変換中（isComposing）では送らない。モバイルの画面（mobile-web）は Enter で改行し、送るのはボタン（外付けのキーボードは Cmd/Ctrl+Enter）。
	"""

includes: [
	"`/embed/agent` の画面（`web/embed/agent.html`、`agent.css`、`agent-frame.js`、`send-view.js`、`send-dom.js`）の作り直し：詳細を既定で畳む、普通のチャットの入力欄（Enter で送る、送るボタン）、確認の画面と期限の表示をなくす",
	"送れるかの口（`GET /api/send/status`）が、今の宛先の指紋（`target`）と種類（`agentType`）を返し、送る意図（`POST /api/send/intent`）が画面から受けた指紋と比べ、違えば送らない",
	"iss-00013 の最終品質ゲートで直さずに残した P2/P3 のうち、作り直しの後も残るものの直し（R-07）",
	"README.md と AGENTS.md の送信の説明の書き直しと、試しの画面（`npm run trial`）での見え方の写し（Mac の幅と 390px）",
	"epic-00004 の requirement.cue と design.cue の、確認の3段に関わる節の書き直し（統括の了承、2026-11-14）",
]

excludes: [
	"送る経路（`src/orca/send.ts` の terminal.send・agentSession.send、`send-gates.ts` の門）の変更。送る経路も再送の道も足さない",
	"送信の記録の形（`orca-web.send-record/v1`）の変更",
	"受け箱、木、一覧、稼働の印（iss-00027）、開くボタンの部品の変更",
	"試しの画面（`web/trial/`）の作りの変更（iss-00014 の P3 の空の横の欄を含む。写しを撮るために使うだけ）",
	"SpecDock 側の組み込み（spec-dock の epic-00471・00526）",
	"権限の承認の代行、割り込み、待ち行列",
]

requirements: {
	"R-01": {
		title: "詳細の部分が、幅によらず既定で畳まれ、押すと開ける"
		text:  "`/embed/agent` の詳細（状態、種類、モデル、推論、親子、PR と CI など）は、初めに畳んで出す。押すと開き、5 秒ごとの描き直しでも開いたまま（閉じたまま）を保つ。題名と「Orca で開く」（幅 390px より広いとき）は畳まずに出す。"
		acceptance: [
			"幅 1280px と 390px のどちらで開いても、詳細が畳まれていて、会話が見える",
			"詳細を開いて 5 秒より長く待っても、開いたままになっている",
		]
	}
	"R-02": {
		title: "利用者が、入力欄に書いて Enter で送り、Shift+Enter で改行できる。変換中の Enter では送らない"
		text: """
			キーボードが主の端末では、Enter（Shift も Alt も押していない）で送り、Shift+Enter で改行する。Cmd+Enter と Ctrl+Enter も送る。日本語の変換中（isComposing、または keyCode 229）の Enter では送らず、変換の確定だけをする。
			タッチが主の端末（`(hover: none) and (pointer: coarse)`）では、Enter で改行し、送るボタンで送る（外付けのキーボードの Cmd/Ctrl+Enter も送る）。統括の判断（2026-11-14、案A。Orca のモバイルの画面と同じ）。
			どの端末でも、入力欄の右に送るボタンを置く。本文が空白だけなら、送るボタンは押せず、Enter は何もしない。入力欄は本文に合わせて数行まで伸び、それより長いと欄の中でスクロールする。
			"""
		acceptance: [
			"キーボードが主の端末で、Enter で送られ、Shift+Enter で改行が入り、送られない",
			"変換中の Enter（isComposing が真、または keyCode 229）では送られない",
			"タッチが主の端末で、Enter で改行が入って送られず、送るボタンで送られる",
			"送るボタンが Mac の幅と 390px の両方で出て、空の本文では押せない",
		]
	}
	"R-03": {
		title: "確認の画面、確かめるボタン、期限の表示がなく、1回の操作で送れる"
		text: """
			送る操作（Enter か送るボタン）の1回で、画面は送る意図と確定を続けて送る。宛先の一覧、『この宛先に、この本文を送ります』、期限は出さない。
			送っている間は欄を止めて「送っています…」と短く示す。届いた（accepted・input_accepted・submitted）ら、欄を空にし、短い知らせ（例『送りました』）を出す。
			要確認の warning（agent_not_verified、composer_may_hold_text、permission_after_submit、agent_mismatch、after_record_failed）は、その短い知らせの下に1行ずつ出す。送った本文は会話の記録（会話の API）から会話に出る。
			"""
		acceptance: [
			"送る操作の1回で、`POST /api/send/intent` と `POST /api/send/confirm` がちょうど1回ずつ送られ、確認の画面を経ない",
			"画面に確認の画面、「確かめる」ボタン（送る前のもの）、期限の表示がない",
			"届いたら入力欄が空になり、warning があればその言葉が出る",
		]
	}
	"R-04": {
		title: "画面が見ている宛先から変わったとき、送れない状態のときは、送らずに理由を短く示し、本文を欄に残す"
		text: """
			送れるかの口が今の宛先の指紋（runtime、worktree、タブ、leaf、handle、ptyId、incarnation、種類、provider のセッション（構造化 Chat はセッション）から作る。識別子そのものは出さない）を返す。
			画面は、最初に送れると分かった時の指紋を「見ている宛先」として固定し、送る意図に添える。その後の送れるかの読みが別の指紋を返しても上書きしない。欄を止めて『宛先が変わりました』と「新しい宛先で続ける」を出し、利用者が押すまで送らない（押すと新しい指紋を固定する）。
			送る意図は、その時の宛先の指紋と比べて違えば送らない（target_changed）。確定はこれまでどおり、意図の時の宛先と比べて確かめ直す（前面のプロセス、ptyId・incarnation・providerSession、本文）。
			送れないとき（sendEnabled が偽、権限の確認待ち、前面がシェル、前面が別のプログラム、タブがない、スリープなど）は欄を止めて理由を1行で示す。意図か確定が送る前に拒まれたら、本文を残し、理由を1行で示し、送れるかを読み直す（send_disabled ならすぐ欄を止める）。
			"""
		acceptance: [
			"画面が固定した指紋と、送る時の宛先の指紋が違うと、送る RPC を送らず、本文が欄に残り、「宛先が変わった」趣旨の1行が出る",
			"書いている間に送れるかの読みが別の指紋を返すと、欄が止まり「新しい宛先で続ける」が出て、押すまで Enter でも送るボタンでも送られない",
			"指紋を添えない意図（実機の確かめの道具など、今の使い方）はこれまでどおり受ける",
			"送れない理由（foreground_mismatch を含む）が、識別子ではなく言葉で出る",
		]
	}
	"R-05": {
		title: "二重送信を防ぎ、結果不明は自動で送り直さず、確かめられる"
		text: """
			送っている間の Enter と送るボタンの押しは捨てる。1回の送る操作に1つの操作の ID（意図が返すもの）を使う。
			確定の応答が来ない、読めない、unknown のときは、結果不明の帯（『届いたか分かりません。自動では送り直しません』と「確かめる」「閉じる」）を出す。帯が出ている間は、本文を欄に残したまま、Enter も送るボタンも送らない。
			「確かめる」は `GET /api/send/{操作の ID}?check=1` で照会する。届いたと分かれば欄を空にし、送っていない（not_sent・refused）と分かれば本文を残して書けるように戻す。「閉じる」は本文を残して書けるように戻す（利用者が改めて送るのは、新しい操作として利用者が決める）。
			"""
		acceptance: [
			"送っている間に Enter と送るボタンを何度押しても、意図と確定は1回ずつ",
			"確定の応答を失うと結果不明の帯が出て、Enter と送るボタンでは送られず、「確かめる」で意図の操作の ID の照会が送られる",
			"照会が届いたと示せば欄が空になり、送っていないと示せば本文が残る",
		]
	}
	"R-06": {
		title: "送信の守りが、確認の段をなくした後も内部で保たれる"
		text:  "サーバーの preflight（前面のプロセス、ptyId・incarnation・providerSession、権限の確認待ち）、使い捨ての票（期限は内部だけ）、送る前の記録、結果の5つの区別、照会、`sendEnabled`、書き込みの守り（Host の完全一致、同じオリジンの JSON、短期のトークン、CORS なし）は変えない。画面は書き込みを `write.js` の短期のトークンで送る。"
		acceptance: [
			"既存の送信のテスト（`test/send/*`、`test/server/send-api.test.ts`、`test/orca/send*.test.ts`）が、指紋の追加と、R-07 の直しで意味が変わる assert（`test/send/journal.test.ts` の、確定した照会の後に unknown の照会を足したときの結果）のほかは変えずに通る",
			"`sendEnabled` が偽なら、画面の欄は止まり理由が出て、意図と確定は 403 になる",
		]
	}
	"R-07": {
		title: "iss-00013 で残した P2/P3 のうち、作り直しの後も残るものを直す"
		text: """
			iss-00013 の report.md の『直していない P2/P3』を1つずつ扱う。
			(a) 送る欄に foreground_mismatch の言葉がない → 言葉を足す（R-04）。README の前面の説明「シェルでない」→「宛先のエージェントそのもの」に直す。
			(b) 同じ ID の照会が並ぶと、後着の unknown の照会が、先の確定した結果を隠す → 記録の読みは、照会の行のうち最後の unknown でない結果を採る。
			(c) 照会の結果の追記に失敗しても応答で示さない → 照会の応答に `checkWarning: "check_record_failed"` を付け、画面が1行で示す。
			(d) 記録のファイルの読みが ENOENT 以外で失敗すると、メモリーにある refused も照会できない → 読めないときは、この起動のメモリーの行があればそれで答え、なければ `record_unreadable`（503）を返す。読めないことを not_sent と示さない。
			(e) 再起動の直後の照会で分かった method_not_found の経路を止めない → 照会も、その時の runtime の ID を確かめてから、同じ runtime の間その経路を止める。
			(f) 構造化 Chat で、カードが消え、handoff が rejected のとき、照会が accepted と示す → 照会では、カードがなく、queuedMessageId でだけ当たった submission が rejected なら unknown（`card_gone`）と示す（届いたとも送っていないとも言わない）。
			"""
		acceptance: [
			"(a)〜(f) のそれぞれに、直したことを確かめるテストがある",
			"(f) で、照会が accepted も refused も返さない",
		]
	}
	"R-08": {
		title: "直した後の見え方と送信を、試しの画面と検証用の宛先で確かめ、文書を直す"
		text: """
			`npm run trial` の試しの画面で、詳細とチャットの iframe を Mac の幅（1280px）と 390px の枠で写し、report.md に残す（会話の本文は写さない：写す前に会話の欄をぼかす）。
			試しの送り先（`send-test` の Claude と Codex の2つだけ。試し専用の settings.json だけ `sendEnabled: true`）に、Enter で1回ずつ送り、結果と記録の行の数を確かめる。README.md と AGENTS.md の送信の流れの説明を、確認の画面のない流れに直す。
			"""
		acceptance: [
			"report.md に、Mac の幅と 390px の写しと、詳細が畳まれていること、送るボタンが出ていること、横のはみ出しがないことの結論がある",
			"試しの送り先の2つに Enter で送った結果（outcome と記録の行の数）が report.md にあり、業務中のエージェントには送っていない",
			"README.md と AGENTS.md に、確認の画面・「確かめる」・期限の説明が残っていない",
		]
	}
}

