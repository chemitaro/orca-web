package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "読むことと、既存のタブを前面に出すだけ。新しいタブを作らない誤りは画面で戻せる"
}

purpose: "orca-web の土台、状態の API、「Orca で開く」と単独のボタン、常駐を作り、SpecDock の epic-00471（図への状態の重ね）を始められるようにする。"

background: "親の init-00002 の R-01〜R-04、R-08、F-01、F-02、F-04 を受ける。調査と ChatGPT の設計の相談は orca-web の .workbench/research-20261106/ にある（Git の管理外）。"

includes: [
	"TypeScript の Node のプロジェクトの雛形、テスト、lint",
	"Orca のアダプター（CLI と内部の Unix ソケットの RPC）と機能ごとの確かめ",
	"状態の API と表示する項目の選択",
	"開く口と単独のボタンの部品、書き込みの守り",
	"launchd での常駐、実機での受け入れ",
]

excludes: [
	"会話のログと送信（epic-00004）",
	"SpecDock 側の図への重ね（spec-dock の epic-00471）",
]

requirements: {
	"R-01": {
		title: "状態の API が、repo・worktree・エージェント・オーケストレーションの状態を返す"
		text: """
			種類、状態、状態の開始時刻、最後に動いた時刻、題名、親子（parentPaneKey、Task の親子、worktree の親子）、PR と CI、
			取れるときのモデルと推論レベル（値の意味と取得元を付ける）を返す。各項目に鮮度、取得元、欠けた理由を付ける。
			ページングを最後まで読み、最初の応答を全件と見なさない。プロンプトやツールの入力など表示に要らない中身は返さない。
			"""
		acceptance: [
			"録画した Orca の応答から、期待する正規化した JSON が得られる",
			"この Mac の実機で、動いている Claude Code と Codex とオーケストレーションの担当が返る",
			"取れない値は null と欠けた理由で返り、別の値から作られない",
		]
	}
	"R-02": {
		title: "表示する項目を利用者が選べる"
		text:  "取れる項目の一覧と、選んだ項目の設定を持ち、状態の画面は選んだ項目だけを表示する。"
		acceptance: ["項目を選ぶと、状態の画面の表示が選んだ項目だけになり、再起動の後も残る"]
	}
	"R-03": {
		title: "SpecDock が worktree を Scope に結び付けられ、状態を読める"
		text:  "worktree ごとにパス、ブランチ、識別子を返す。SpecDock の正確なオリジンにだけ、読み取りの CORS を許す。"
		acceptance: ["SpecDock のオリジンからの読み取りが通り、ほかのオリジンからは拒まれる"]
	}
	"R-04": {
		title: "開く口が、この Mac の Orca で既存のタブを前面に出す"
		text: """
			指定のエージェント、なければ worktree の最後に動いたエージェントのタブ、なければ最後に見ていたタブ、なければ worktree だけを前面に出す。
			動いている端末は terminal switch、ほかのタブは session.tabs.activate、タブがなければ worktree.activate を使い、navigation は host に固定する。
			スリープ中のエージェントは、Orca の通常の動きとして復元してよい。新しいタブやファイルを作る経路を持たない。
			"""
		acceptance: [
			"実機で、エージェントのタブ、最後のタブ、worktree だけ、の3つの場合がそれぞれ前面に出る",
			"押す前と後でタブの集合を比べ、スリープからの復元のほかにタブが増えない",
		]
	}
	"R-05": {
		title: "「Orca で開く」のボタンを、単独で別の画面に置ける"
		text:  "ボタンの部品は、状態の画面やチャットを読み込まずに、別のオリジンの画面に置ける。スマホの幅では出ない。"
		acceptance: ["SpecDock の別のオリジンの試しの画面にボタンだけを置き、押すと開く", "幅 390px ではボタンが出ない"]
	}
	"R-06": {
		title: "この Mac で常駐し、127.0.0.1 と指定の Tailscale の IP だけで待ち受ける"
		acceptance: ["launchd で起動し、ログインし直しても動く", "待ち受けのアドレスが2つだけで、0.0.0.0 にならない"]
	}
}

failures: {
	"F-01": {title: "Orca が動いていない、つながらないときは、状態の API は「接続できない」と最後に読めた状態を鮮度つきで返し、画面を止めない"}
	"F-02": {title: "必要な機能が確かめられないとき（method_not_found、識別子の欠け、未知の形）は、読む機能は欠けを示して続け、開く口は何もせずに理由を返す"}
	"F-03": {title: "開く口が時間切れや結果不明のとき、別のタブへ切り替えず「開いたか確かめられない」と返す"}
	"F-04": {title: "別のオリジン、許していない Host、トークンのない書き込みを拒む"}
}

constraints: [
	"Orca の authToken とペアリングのコードを、記録、URL、画面、ログ、録画に出さない",
	"録画では、パスやセッションの ID を一貫した仮名に置き換え、同じかどうかと親子は保つ",
]
