package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "読むだけの画面。誤りは表示で分かり、直せる"
}

purpose: "orca-web 単独の画面を作る。入口は要対応の受け箱。あわせてオーケストレーションの木と、プロジェクトごとの画面を出す。"

background: "親の init-00002 の R-09、R-10 を受ける（2026-11-13 の利用者の判断。画面案 https://claude.ai/artifact/3JjSLt7RWBdv92znTHgKER、設計案 https://claude.ai/artifact/R4uRVUWgQeXsbTpet8Y9qu）。今の一覧の表（iss-00006）は、この Epic の画面で置き換える。"

includes: ["要対応の受け箱（全プロジェクト、プロジェクトの絞り込み）", "オーケストレーションの木（Run ごと）", "プロジェクトの画面"]
excludes: ["送信（epic-00004 の iss-00013）", "SpecDock への組み込み"]

requirements: {
	"R-01": {
		title: "要対応の受け箱が、エージェントを4つの段に分ける"
		text: """
			要対応：state が blocked（許可待ち）・waiting（入力待ち）、統括あての未処理の question・decision_gate、worker_done で届いたマージ待ちの PR。
			止まっている：CI の失敗、30分以上出力のない working、終了した端末。動いている：working。終わった：done とスリープ（畳み、最後の一言を見せる）。
			各項目に、プロジェクト、Issue（分かれば）、エージェントの種類、経過の時間、最後の一言を出し、詳細とチャット、Orca で開く（Mac だけ）、PR へ進める。
			オーケストレーションの連絡は --peek で読み、既読にしない。
			"""
		acceptance: [
			"録画した状態と連絡から、各段に期待どおりの項目が入る",
			"実機で、許可待ちのエージェントと統括あての質問が要対応の段に出る",
			"受け箱を開いても、統括の連絡が既読にならない",
		]
	}
	"R-02": {
		title: "受け箱をプロジェクトで絞り込め、PC とスマホで使える"
		acceptance: ["プロジェクトを選ぶと、その項目だけが出る", "幅 390px で横にはみ出さずに読め、Orca で開くが出ない"]
	}
	"R-03": {
		title: "オーケストレーションの木が、Run ごとに親子を1本の木で示す"
		text: """
			統括と作業者の親子、担当の Issue、モデル（作業者の起動時の値）、推論、状態、経過を出す。作業者の worktree が統括と別のプロジェクトにあれば、
			その節にプロジェクトの札を付け、木は分けない。取れない値は「—」。オーケストレーションで起動していないエージェントは木に入れない。
			"""
		acceptance: ["プロジェクトをまたぐ Run が1本の木で出て、別のプロジェクトの節に札が付く", "録画した Run・Task・worker から、期待どおりの木が組める"]
	}
	"R-04": {
		title: "プロジェクトの画面が、そのプロジェクトの受け箱と、そこに節がある Run を出す"
		text:  "統括が別のプロジェクトにいる Run には「<プロジェクト> の統括から」の札を付ける。"
		acceptance: ["プロジェクトの画面に、そのプロジェクトに節が1つでもある Run が全部出る"]
	}
}

failures: {
	"F-01": {title: "Orca に届かない、連絡が読めないときは、最後に読めた内容を鮮度つきで示し、読めない部分を示す"}
	"F-02": {title: "段を決める根拠が欠けたエージェントは、推測で要対応にせず「不明」として示す"}
}
