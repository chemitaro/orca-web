package spec

// 要件（Epic）。型 specdock/v1。

schema: "specdock/v1"

assurance: {
	level:  "strict"
	reason: "エージェントへの誤送信や二重送信は取り消せず、作業を壊しうる"
}

purpose: "エージェントの会話のログをチャットの形で読み、確かめたうえで指示を送る軽い小窓を作り、SpecDock のダッシュボードに埋め込めるようにする（spec-dock の epic-00526 の土台）。"

background: """
	親の init-00002 の R-05、R-06、R-07、F-03 を受ける。epic-00003 で、読むアダプター、機能の確かめ、書き込みの守り（Host、Origin、短期のトークン）、
	録画と再生のテストができた。iss-00005 の実機の確かめで、nativeChat.readSession が 10/10 で読めた。
	ChatGPT の design-01（orca-web の .workbench/research-20261106/consult/）の第4節と第6節が、送信の守りの根拠。
	"""

includes: [
	"会話のログの API（通常の Claude Code と Codex、構造化 Chat）と、チャットの形の小窓",
	"確認つきの送信（送る意図→確かめ→確定のときの確かめ直し）と、送った記録",
	"SpecDock のダッシュボードへの iframe の埋め込みと、Mac とスマホでの受け入れ",
]

excludes: [
	"権限の承認の代行、割り込み（interrupt）、待ち行列",
	"エージェントの起動と停止",
	"SpecDock 側の組み込みそのもの（spec-dock の epic-00471・epic-00526。利用者の確かめの後に行う）",
]

requirements: {
	"R-01": {
		title: "利用者が、エージェントの会話のログをチャットの形で読める"
		text: """
			Orca が持つ会話の記録（通常のエージェントは nativeChat.readSession／subscribe、構造化 Chat は agentSession.history／subscribe）から読む。
			指示と返答の本文を吹き出しで並べ、ツールの呼び出しと結果は折り畳む。思考は出さない。未対応の部分は「表示できない」と示す。
			追記と置き換えを分けて扱い、別の会話を混ぜない。端末の画面から会話を組み立てない。本文はテキストとして描き、HTML として解釈しない。
			"""
		acceptance: [
			"録画した会話の記録から、本文の吹き出しと折り畳んだツールが表示され、思考が出ない",
			"実機で、Claude Code と Codex の会話が、Orca の画面と同じ順で表示される",
			"記録が置き換わったとき、古い表示が残らない",
		]
	}
	"R-02": {
		title: "利用者が、宛先と本文を確かめたうえで、エージェントに指示を送れる"
		text: """
			送る前に、リポジトリ、worktree とブランチ、エージェントの種類、題名、状態、セッションの短い識別子、本文を示して確かめる。
			作業中のエージェントにも送れる（利用者の判断）。確定したときに、宛先の同一性、Orca の世代、本文の一致を確かめ直し、変わっていれば確かめに戻る。
			Orca の送る直前の保護の経路（構造化 Chat は agentSession.send の契約、端末は送る直前に宛先を確かめる経路）を使う。
			"""
		acceptance: [
			"確かめの画面に宛先と本文が出て、確定するとその宛先にだけ届く",
			"確かめの後に宛先が変わる（エージェントが終わる、同じ枠で別のエージェントが動く）と、送らずに確かめに戻る",
		]
	}
	"R-03": {
		title: "送った指示の記録が、この Mac の中に残る"
		text:  "操作の ID、宛先、時刻、本文、確かめた世代、結果（受け付けた、入力を受けた、送信を確かめた、結果不明、拒んだ）を、送る前と後に記録する。記録できなければ送らない。"
		acceptance: ["送るたびに、送る前と後の記録が残り、結果の5つの区別が分かる", "記録の置き場に書けないときは送られない", "結果不明の送信を、同じ操作の ID で確かめられる"]
	}
	"R-04": {
		title: "SpecDock に、詳細とチャットと稼働の印を渡せる"
		text: """
			(1) `/embed/agent?id=…`：エージェントの詳細（状態、種類、モデル、推論、親子、PR と CI、Orca で開く）とチャット（読む、確かめて送る）の iframe。
			単独の画面からも同じ詳細を開く。(2) 稼働の印の要約の API：worktree ごとのエージェントの数と状態を、SpecDock が図に描ける小さな JSON で返す。
			SpecDock の別のオリジンの試しの画面で、Mac とスマホ（幅 390px）で使える。SpecDock への組み込みの前に、利用者が画面と動作を確かめる。
			"""
		acceptance: [
			"SpecDock のオリジンの試しの画面に詳細とチャットの iframe を置き、Mac とスマホで読んで送れる。ほかのオリジンには埋め込めない",
			"要約の API が worktree ごとにエージェントの数と状態を返し、試しの画面に丸の並びで描ける",
			"利用者の確かめが済んだことが記録される",
		]
	}
}

failures: {
	"F-01": {
		title:    "宛先が確かめのときから変わったら、送らずに確かめに戻る"
		impact:   "別のエージェントやシェルに指示が入り、作業を壊す"
		recovery: "最新の宛先で確かめ直す。送ってしまった場合は記録から宛先と本文を特定し、Orca の画面で対処する"
	}
	"F-02": {
		title:    "権限の確認待ちなど、送ると誤動作する状態では送らない。シェルへの代わりの送信もしない"
		impact:   "権限の承認や拒否として受け取られ、意図しない操作が進む"
		recovery: "Orca の画面で利用者が確認に答えてから、送り直す"
	}
	"F-03": {
		title:    "結果が分からない送信を、新しい要求として送り直さない"
		impact:   "同じ指示が2回届き、作業が2回行われる"
		recovery: "記録の『結果不明』を示し、同じ操作の ID で状態を確かめる。届いていなければ利用者が改めて送る"
	}
	"F-04": {
		title:    "送る経路が確かめられない（Orca の更新で形が変わった、保護の経路がない）ときは、その組み合わせの送信を止める"
		impact:   "保護のない経路で送り、F-01・F-02 を防げない"
		recovery: "読むことは続け、送信のボタンを止めて理由を示す。Orca に合わせて直してから有効にする"
	}
	"F-05": {
		title:    "会話の記録が読めないとき、空の会話ではなく『読めない』と示す。別の会話を混ぜない"
		impact:   "利用者が状態を取り違え、誤った指示を送る"
		recovery: "理由を示し、Orca の画面で確かめるよう促す"
	}
	"F-06": {
		title:    "別のオリジン、許していない Host、古い確かめ（失効、使い済み）からの送信を拒む"
		impact:   "悪意のある画面や古い画面から、利用者の意図しない指示が送られる"
		recovery: "拒んだことを記録し、画面を開き直して確かめ直す"
	}
}

constraints: [
	"Orca の認証の情報を、記録、URL、画面、ログ、録画に出さない",
	"会話の本文とツールの出力は信頼しないデータとして扱い、テキストとして描く",
	"送信の記録は、この Mac の利用者の置き場だけに置き、権限を絞る",
]

decisions: [
	"2026-11-06 作業中のエージェントにも区別せず送る（利用者の判断。ChatGPT の『拒否』の推奨より優先）",
	"2026-11-06 ログは本文中心、ツールは折り畳み、思考は出さない",
	"2026-11-06 送信の記録は宛先・時刻・本文を Mac の中だけに残す",
	"2026-11-06 スマホから送れる",
	"2026-11-13 送信は設定で止められる（止めると読むだけになる）",
	"2026-11-13 SpecDock へは詳細とチャット、稼働の印、開くボタンの3つ。全体の画面は渡さない。組み込みの前に利用者が確かめる",
]
