package spec

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "画面（web/）の表示と配置だけを変える。サーバーと Orca への操作を足さない。PR を戻せば元に戻る"
}

purpose: "指揮の画面で、選んだ頂点の会話をなるべく広く出す。スマホでは見出しの情報（チームの帯・対応のカード・重なった題名と Open）が画面の上半分を占めているので、詳細は切り替えで出す形にし、上下の高さを会話に使う。あわせて、低い窓で会話の外枠が巻かれ、下に余白が出る不具合を直す。"

background: """
	利用者の依頼（2026-11-26、会話、スマホの画面の写し）：スマホでチャットを開くと、チャットが画面の下半分ほどしか出ず、基礎的な情報が上半分を占める。チャットをなるべく広く出したい。詳細はなるべく隠し、必要なときに表示を切り替えて出す。画面の上下を最大限に使いたい。
	また PC のブラウザで窓の高さを低くすると、右のチャットの下に余分な空間が出て、チャットの巻きとは別に、チャットの外枠の縦のスクロールバーが出る。別の Issue で進めてよい。
	タスク担当の再現（2026-11-26、常駐の orca-web）：`/embed/agent` の枠の高さが 430px より低いと、枠の中の文書の高さが 430px のまま残って文書が巻かれる。原因は、会話の中のリンクに付く読み上げ用の文字（`.vh`、position: absolute）の包む箱が初めの箱になり、巻きの箱（`main`、`header`）の外へはみ出して文書を伸ばすこと。`main` と `header` を position: relative にすると、文書の高さが枠の高さと同じになることを実物で確かめた。
	スマホの画面（幅 393、選んだとき）：右のペインの見出しの帯（「← 一覧」・状態・題名・Open が2行）、チームの帯、対応のカード、枠の中の見出し（題名・Open・詳細）が重なり、会話は下の半分ほど。
	"""

includes: [
	"`web/embed/agent.css`：巻きの箱の外へ絶対配置の要素がはみ出さないようにする",
	"`/embed/agent` の `head=compact`（題名の行を隠し、詳細の畳みだけを残す）と、指揮の画面の枠での使用",
	"指揮の画面の右のペインの、詳細の切り替え（チームの帯と対応のカードを畳む）",
	"幅 900px 未満で頂点を選んだときの、余白を詰めた1行の見出し",
]
excludes: ["サーバー（`src/`）", "受け箱・Run の木の画面", "`/embed/agent` を単独や SpecDock で使うときの見た目（`head=compact` がないときは今のまま。はみ出しの修正だけは入る）"]

requirements: {
	"R-01": {
		title: "会話の枠の文書は枠の高さを超えない"
		text:  "`/embed/agent` の文書は、どの枠の高さでも、巻ける高さ（scrollHeight）が見える高さ（clientHeight）を超えない。巻けるのは会話の欄（`main`）と、見出しの中の詳細だけ。会話の中の絶対配置の要素（`.vh` など）は、その巻きの箱の中に収まる。"
		acceptance: [
			"agent.css で `header` と `main` と送る欄 `#send` が position: relative",
			"実物で、枠の高さ 200px の `/embed/agent` の文書の scrollHeight が 200 で、外枠のスクロールバーが出ない",
		]
	}
	"R-02": {
		title: "枠の中の見出しを詰める（head=compact）"
		text:  "`/embed/agent?...&head=compact` のとき、枠の中の見出しは題名の行（題名と Open）を出さず、畳んだ「詳細」の行だけを出す。詳細を開けば今の中身が出る。指揮の画面は、選んだ頂点とメンバーの枠をいつも `head=compact` で作る（題名と Open は右のペインの見出しにあるため）。`head=compact` がないときは今のまま。"
		acceptance: [
			"`frameSrc(id)` と `frameSrc(id, {compose: false})` が `head=compact` を含む",
			"agent-frame が `head=compact` で body に印の class を付け、agent.css がその class で `.title-row` を隠す",
		]
	}
	"R-03": {
		title: "詳細（チームの帯と対応のカード）は切り替えで出す"
		text: """
			右のペインの見出しの帯に「詳細」の切り替えのボタン（aria-expanded）を置く。チームの帯と対応のカードは、1つの畳める欄に入れ、ボタンで出し入れする。メンバーの枠の帯と下書きの結果の帯は、いつも出す（今の枠の状態を示すため）。
			畳んでいるとき、対応のカードが1つ以上あれば、ボタンに「対応 n」を添えて対応が必要の色にする（見落とさないため）。
			始めの状態は、幅 900px 未満か高さ 700px 以下の窓では畳み、それ以外では開く。利用者が切り替えたら、そのページの間は（頂点を替えても）その状態を保つ。
			"""
		acceptance: [
			"切り替えのボタンを押すと、チームの帯と対応のカードの欄が出入りし、aria-expanded が変わる",
			"畳んでいてカードが2つなら、ボタンに「対応 2」が出る。カードがなければ添えない",
			"始めの状態が窓の条件で決まり、切り替えた後は頂点を替えても保たれる",
		]
	}
	"R-04": {
		title: "狭い幅で選んだときは、見出しを1行にし余白を詰める"
		text:  "幅 900px 未満で頂点を選んだとき、ページの余白と右のペインの枠線をなくして画面いっぱいに出す（高さ 100dvh）。見出しの帯は1行で、題名は1行に収めて省略し（…）、「← 一覧」・状態・題名・詳細・Open が横に流れない。"
		acceptance: [
			"900px 未満の media で、選んだときの body の余白が 0、右のペインの高さが 100dvh で枠線がない",
			"900px 未満の media で、右のペインの見出しの帯が折り返さず、題名が1行で省略（text-overflow: ellipsis）",
			"実物の狭い窓で、会話の枠が窓の高さの半分より大きい（畳んだ始めの状態で）",
		]
	}
}

failures: {
	"F-01": {title: "窓の条件が読めない", text: "matchMedia が使えなければ、詳細は開いた状態で始める（今のふるまい）。"}
}

constraints: ["AGENTS.md：DOM は textContent だけ。iframe の src を書き換えず作り直す（mountAgentFrame）。`/embed/agent` の中で移らない", "実行時の依存を足さない"]
decisions: [
	"スマホでチャットを広く出し、詳細は隠して切り替えで出す（利用者、2026-11-26、会話）",
	"低い窓で会話の外枠が巻かれる不具合を、同じ Issue で直す（利用者は別の Issue を勧めた。iss-00102 とは別の Issue にし、2つの不具合は同じ画面の高さの問題なのでこの Issue にまとめる。タスク担当、2026-11-26）",
	"コーディングは Opus 5.5 で行う（利用者、2026-11-26、会話）",
	"枠の中の題名と Open は、右のペインの見出しと重なるので、指揮の画面では隠す（タスク担当、2026-11-26）",
]
